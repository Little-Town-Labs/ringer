          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) filter (where verdict = 'PASS') as \"PASS\", count(*) filter (where verdict = 'FAIL') as \"FAIL\", count(*) filter (where verdict = 'TIMEOUT') as \"TIMEOUT\", count(*) filter (where verdict = 'ERROR') as \"ERROR\" from ringer.attempts where $__timeFilter(logged_at) and source_host in ($host) and model in ($model) and task_type in ($task_type)",
