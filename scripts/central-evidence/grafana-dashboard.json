    {
      "id": 7,
      "type": "table",
      "title": "Model scoreboard",
      "description": "Per model and task type. First-try % counts only attempts that were not retries; Pass % counts every attempt.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select model as \"Model\", task_type as \"Task type\", count(*) as \"Attempts\", round(100.0 * count(*) filter (where verdict = 'PASS' and coalesce(retry, false) = false) / nullif(count(*) filter (where coalesce(retry, false) = false), 0), 0) as \"First-try %\", round(100.0 * count(*) filter (where verdict = 'PASS') / count(*), 0) as \"Pass %\", count(*) filter (where verdict = 'TIMEOUT') as \"Timeouts\", round(avg(duration_ms) / 60000.0, 1) as \"Avg min\", round(avg(worker_tokens) / 1000.0, 0) as \"Avg k tokens\" from ringer.attempts where $__timeFilter(logged_at) and source_host in ($host) and model in ($model) and task_type in ($task_type) group by 1, 2 order by 3 desc limit 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First-try %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 50
                    },
                    {
                      "color": "#0ca30c",
                      "value": 75
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pass %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 50
                    },
                    {
                      "color": "#0ca30c",
                      "value": 75
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
