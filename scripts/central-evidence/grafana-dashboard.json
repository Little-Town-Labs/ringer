          "rawQuery": true,
          "rawSql": "select logged_at as \"Time\", source_host as \"Host\", task_key as \"Task\", model as \"Model\", task_type as \"Task type\", verdict as \"Verdict\", round(duration_ms / 60000.0, 1) as \"Minutes\" from ringer.attempts where $__timeFilter(logged_at) and verdict <> 'PASS' and source_host in ($host) and model in ($model) and task_type in ($task_type) order by logged_at desc limit 50",
