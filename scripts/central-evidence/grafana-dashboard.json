    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens per day by model",
      "description": "Worker tokens per day, top 8 models in the selected range; the rest are grouped as Other. Colors follow the model name.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with ranked as ( select model from ringer.attempts a where $__timeFilter(a.logged_at) and a.source_host in ($host) and a.model in ($model) and a.task_type in ($task_type) group by model order by sum(worker_tokens) desc nulls last limit 8) select $__timeGroupAlias(a.logged_at, '1d'), coalesce(r.model, 'Other') as metric, coalesce(sum(a.worker_tokens), 0) as value from ringer.attempts a left join ranked r on r.model = a.model where $__timeFilter(a.logged_at) and a.source_host in ($host) and a.model in ($model) and a.task_type in ($task_type) group by 1, 2 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 90,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "axisLabel": "Tokens",
            "spanNulls": false,
